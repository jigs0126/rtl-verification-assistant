# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM ---
# Gemini API key from aistudio.google.com (never commit your real .env)
LLM_API_KEY=your-api-key-here
# Check Google AI Studio for the current model names
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2

# --- Embeddings ---
# Default is a local sentence-transformers model (no API cost after the
# model weights are downloaded once). Swap for an API embedding model name
# if you prefer.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage / paths ---
VECTOR_DB_PATH=data/vector_store
DOCUMENTS_PATH=.
LOG_PATH=data/logs

# --- RAG parameters ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
